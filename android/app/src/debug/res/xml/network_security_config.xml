<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. Overrides the release file of the same name.
    Plain HTTP is allowed ONLY to this device's localhost, which `adb reverse tcp:8080 tcp:8080`
    forwards to the backend on the developer's laptop. Everything else stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

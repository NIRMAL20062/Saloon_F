# Copy to .env for local development. Never commit .env.
# Every value here is a LOCAL default. Staging/production values live in the
# hosting provider's secret store and in GitHub Actions secrets — never in git.

# ---- Backend ----
APP_ENV=local
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/glide
DATABASE_USER=glide
DATABASE_PASSWORD=glide_local_only
# Comma-separated list of browser origins allowed to call the API (the admin panel).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Max requests per minute from one client IP (default 300).
RATE_LIMIT_PER_MINUTE=300
# Supabase project used for logins (D-016). Public value: the backend only reads its public signing keys.
# This is the team's development project. Never put the secret (sb_secret_...) or service_role key here unless a task needs it.
SUPABASE_URL=https://uwvaebgbdqitbnymoqfq.supabase.co

# ---- Admin panel ----
# Next.js reads its own file: copy admin/.env.example to admin/.env.local.
